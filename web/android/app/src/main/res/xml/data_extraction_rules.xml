<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nada do app vai para a cópia de segurança na nuvem nem é
  transferido para um telemóvel novo. O armazenamento do WebView guarda
  o token de sessão,restaurá-lo noutro aparelho iniciaria sessão
  sozinho, sem password. Num telemóvel novo, a pessoa entra outra vez.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
